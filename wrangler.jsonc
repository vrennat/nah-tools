{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "nah-tools",
	"compatibility_date": "2026-03-29",
	"compatibility_flags": ["nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "nah-tools-db",
			"database_id": "e2e045cb-6a54-484c-8041-2fee149d52ea"
		}
	],
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "e61ce66823e24e5dba2c0a7a9e4556c0"
		}
	],
	// Workers AI for the link spam gate (src/lib/server/link-gate/).
	"ai": {
		"binding": "AI"
	},
	"ratelimits": [
		{
			// Burst limit on creating short links and dynamic QR codes, keyed by
			// hashed IP and hashed passphrase (see src/lib/server/creation-limits.ts).
			"name": "CREATE_LIMITER",
			"namespace_id": "8714",
			"simple": { "limit": 5, "period": 60 }
		}
	],
	"vars": {
		"CF_ACCOUNT_ID": "5a0a2ffa1e2f5b55c17406b48b489975"
	},
	// Served only on the custom domain; the *.workers.dev address is not used.
	"workers_dev": false,
	"routes": [
		{
			"pattern": "nah.tools",
			"custom_domain": true
		}
	],
	// Workers Logs keeps only this Worker's own console lines (link gate
	// decisions such as link_gate_allow_unreadable, and errors), for 7 days on
	// Workers Paid. Invocation logs stay off: they would store request URLs and
	// headers, including client IPs, which the privacy page says are not kept.
	// Volume is a few lines per link created, far below the free allowance, so
	// every request is sampled.
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": false,
			"head_sampling_rate": 1
		}
	}
}
